---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { latest, targets, mcVersions } from '../lib/releases';
import { site } from '../data/site';

const problems = [
  {
    id: 'crash',
    q: 'The game crashes or does not start after adding the mod',
    a: [
      'Check that the file matches your Minecraft version: the file name ends in the version it is made for, for example <code>mc1.21.11</code>.',
      'Put the <strong>Fabric API</strong> for the same Minecraft version into your mods folder.',
      `Minecraft 1.21.11 needs Java ${targets['1.21.11'].java} or newer, Minecraft 26.2 needs Java ${targets['26.2'].java} or newer. The official launcher brings the right Java with it.`,
      'Remove older copies of the mod (<code>toads-visuals-*.jar</code>, <code>ToadsVisuals-*.jar</code>, <code>textureforge-*.jar</code>) so only one version is in the folder.',
    ],
  },
  {
    id: 'menu',
    q: 'The menu does not open',
    a: [
      'Press <strong>Right Shift</strong> while you are in a world or on a server.',
      'If you changed the key, look under Options → Controls → Key Binds → Toad’s Visuals. With Mod Menu installed you can also open it from the mods list.',
    ],
  },
  {
    id: 'textures',
    q: 'My texture choices do not show up',
    a: [
      'Your choices are applied when you close the menu or press <strong>APPLY</strong>.',
      'Open Options → Resource Packs and make sure <strong>Toad’s Visuals Generated</strong> is switched on and at the top of the list, above your other packs.',
      'Server resource packs can cover your textures. The generated pack only changes what the server pack does not replace.',
    ],
  },
  {
    id: 'packs',
    q: 'My resource packs are missing in the menu',
    a: [
      'Toad’s Visuals reads the packs in your <code>resourcepacks</code> folder (and the folder you choose in Settings → Library). Use <strong>Rescan now</strong> after adding new packs.',
      'Packs must be .zip files or folders that Minecraft itself can load.',
    ],
  },
  {
    id: 'sky',
    q: 'The sky from the sky editor does not appear',
    a: [
      `The sky editor writes an OptiFine-style sky, which needs the <a href="${site.links.skyboxify}" target="_blank" rel="noopener">Skyboxify</a> mod to show in game.`,
    ],
  },
  {
    id: 'logos',
    q: 'I don’t see other players’ logos',
    a: [
      'Logos come from the logo sync. It is on by default and can be found in Settings → Privacy. It needs a signed-in Minecraft account, and the other player needs the mod with logo sync on, too.',
      'New players can take up to five minutes to appear.',
    ],
  },
];
---
<Base
  title="FAQ"
  description="How to install Toad's Visuals, which Minecraft versions are supported, and fixes for common problems."
>
  <section class="page-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <h1>Questions and answers</h1>
      <p class="lead">Installation, supported versions and the fixes for the most common problems.</p>
    </div>
  </section>

  <div class="wrap content">
    <section id="install" aria-labelledby="install-title">
      <h2 id="install-title">Installation</h2>
      <ol class="steps">
        <li>
          <h3>Install Fabric</h3>
          <p>
            Run the <a href={site.links.fabricInstaller} target="_blank" rel="noopener">Fabric installer</a> and choose
            Minecraft {mcVersions.join(' or ')}. Start that Fabric profile once, then close the game.
          </p>
        </li>
        <li>
          <h3>Add Fabric API</h3>
          <p>
            Download <a href={site.links.fabricApi} target="_blank" rel="noopener">Fabric API</a> for the same Minecraft version
            and put it into your <code>.minecraft/mods</code> folder.
          </p>
        </li>
        <li>
          <h3>Add Toad’s Visuals</h3>
          <p>
            <a href="/downloads/">Download version {latest.version}</a> for your Minecraft version and put the .jar file into
            the same <code>mods</code> folder. Remove older versions of the mod.
          </p>
        </li>
        <li>
          <h3>Open the menu</h3>
          <p>Start the game with the Fabric profile, join a world and press <strong>Right Shift</strong>.</p>
        </li>
      </ol>
      <p class="muted note">
        Using a launcher like Modrinth App, Prism or CurseForge? Create a Fabric instance for your Minecraft version and drop
        both .jar files into the instance’s mods folder.
      </p>
    </section>

    <section id="versions" aria-labelledby="versions-title">
      <h2 id="versions-title">Supported versions</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Minecraft</th>
              <th scope="col">Java</th>
              <th scope="col">Fabric Loader</th>
              <th scope="col">Also needed</th>
            </tr>
          </thead>
          <tbody>
            {
              mcVersions.map((v) => (
                <tr>
                  <th scope="row">{v}</th>
                  <td>{targets[v].java}+</td>
                  <td>{targets[v].loader}+</td>
                  <td>{targets[v].fabricApi}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="muted note">
        Toad’s Visuals is a Fabric mod for Minecraft Java Edition. Forge, NeoForge, OptiFine-only setups and Bedrock Edition are
        not supported. It is client-side: servers do not need it.
      </p>
    </section>

    <section id="problems" aria-labelledby="problems-title">
      <h2 id="problems-title">Common problems</h2>
      <div class="faq">
        {
          problems.map((p) => (
            <details id={p.id}>
              <summary>
                {p.q}
                <span class="plus" aria-hidden="true" />
              </summary>
              <div class="answer">
                {p.a.map((t) => (
                  <p set:html={t} />
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section id="servers" aria-labelledby="servers-title">
      <h2 id="servers-title">Servers and fair play</h2>
      <div class="faq">
        <details open>
          <summary>
            Is Toad’s Visuals allowed on servers?
            <span class="plus" aria-hidden="true" />
          </summary>
          <div class="answer">
            <p>
              Toad’s Visuals is a visual mod. It does not change movement, reach, attack speed or hit detection, it does not
              aim or attack for you, and it never shows information you could not see yourself. Item markers only mark your
              own items, fullbright keeps Darkness and Blindness working, and the opacity editor cannot make blocks
              see-through.
            </p>
            <p>
              Every server has its own rules, though. If you are unsure, ask the server’s staff before you play.
            </p>
          </div>
        </details>
        <details>
          <summary>
            I run a server. Can I switch features off?
            <span class="plus" aria-hidden="true" />
          </summary>
          <div class="answer">
            <p>
              Yes. Send the play packet <code>toadsvisuals:server_rules</code> (one VarInt) to switch features off for players
              of the mod until they leave. Value <code>1</code> switches fullbright off.
            </p>
            <p>
              Player logos can be passed on by a server plugin through the channels <code>toadsvisuals:logo</code> (client to
              server: the logo id as UTF-8 text) and <code>toadsvisuals:logos</code> (server to client: a map of player UUID to
              logo id). Clients only send their logo if the player switched on “Share my player logo”.
            </p>
          </div>
        </details>
        <details>
          <summary>
            Does the mod collect data?
            <span class="plus" aria-hidden="true" />
          </summary>
          <div class="answer">
            <p>
              There is no telemetry. The logo sync stores your Minecraft UUID so other players of the mod can see your logo;
              you can switch it off in Settings → Privacy. Details are in the <a href="/privacy/#mod">privacy policy</a>.
            </p>
          </div>
        </details>
      </div>
    </section>

    <aside class="help glass" aria-labelledby="help-title">
      <div>
        <h2 id="help-title">Still stuck?</h2>
        <p class="muted">Ask on the Discord server. Send your game log (<code>logs/latest.log</code>) so we can see what went wrong.</p>
      </div>
      <a class="btn btn-primary" href={site.links.discord} target="_blank" rel="noopener">
        <Icon name="discord" size={20} />
        Ask on Discord
      </a>
    </aside>
  </div>
</Base>

<style>
  .content {
    display: grid;
    gap: clamp(48px, 7vw, 80px);
    padding-bottom: clamp(64px, 9vw, 120px);
  }

  .content > * {
    max-width: 860px;
  }

  .content > * {
    min-width: 0;
  }

  section h2 {
    font-size: var(--step-2);
    margin-bottom: 22px;
  }

  section {
    scroll-margin-top: 96px;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .steps li {
    counter-increment: step;
    position: relative;
    padding: 0 0 26px 58px;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -4px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: rgba(167, 85, 255, 0.16);
    border: 1px solid var(--line);
    color: var(--lilac);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 19px;
    top: 40px;
    bottom: 4px;
    width: 1px;
    background: var(--line);
  }

  .steps h3 {
    margin-bottom: 4px;
  }

  .steps p {
    color: #d6cde3;
  }

  .note {
    margin-top: 6px;
    font-size: 0.97rem;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-panel);
    background: var(--glass);
    margin-bottom: 14px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 460px;
  }

  th,
  td {
    text-align: left;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line-soft);
  }

  thead th {
    font-size: 0.85rem;
    color: var(--faint);
    font-weight: 650;
  }

  tbody tr:last-child > * {
    border-bottom: 0;
  }

  .faq {
    border-top: 1px solid var(--line-soft);
  }

  details {
    border-bottom: 1px solid var(--line-soft);
    scroll-margin-top: 96px;
  }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 14px 0;
    cursor: pointer;
    font-weight: 700;
    font-size: 1.08rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--lilac);
  }

  .plus {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease);
  }

  .plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .answer {
    display: grid;
    gap: 10px;
    padding: 0 44px 22px 0;
    color: #d6cde3;
  }

  details:target summary {
    color: var(--lilac);
  }

  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(22px, 4vw, 34px);
  }

  .help h2 {
    font-size: var(--step-2);
    margin-bottom: 6px;
  }

  .help p {
    max-width: 48ch;
  }

  @media (max-width: 520px) {
    .answer {
      padding-right: 0;
    }
    .help .btn {
      width: 100%;
    }
  }
</style>
