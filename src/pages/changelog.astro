---
import Base from '../layouts/Base.astro';
import changelog from '../data/changelog.json';
import { releases, formatDate } from '../lib/releases';
import NextUpdate from '../components/NextUpdate.astro';

type Entry = { en: string; de?: string };
const groups: { key: 'added' | 'changed' | 'fixed' | 'removed'; label: string }[] = [
  { key: 'added', label: 'New' },
  { key: 'changed', label: 'Changed' },
  { key: 'fixed', label: 'Fixed' },
  { key: 'removed', label: 'Removed' },
];
const downloadable = new Set(releases.map((r) => r.version)); // only the newest version
const versions = changelog.versions as ({ version: string; date: string; title: Entry } & Partial<Record<string, Entry[]>>)[];
---
<Base title="Changelog" description="Every update of Toad's Visuals with release dates and detailed changes.">
  <section class="page-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <h1>Changelog</h1>
      <p class="lead">Every update of Toad’s Visuals, newest first. The same notes are in the mod’s own changelog.</p>
    </div>
  </section>

  <div class="wrap upcoming"><NextUpdate recent={3} /></div>

  <div class="wrap layout">
    <nav class="index" aria-label="Versions">
      <ul>
        {
          versions.map((v, i) => (
            <li>
              <a href={`#v${v.version}`}>
                {v.version}
                {i === 0 && <span class="chip chip-new">Latest</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ol class="versions">
      {
        versions.map((v) => (
          <li class="version" id={`v${v.version}`}>
            <header>
              <h2>{v.version}</h2>
              <time datetime={v.date}>{formatDate(v.date)}</time>
              {downloadable.has(v.version) && (
                <a class="dl" href="/downloads/#latest" aria-label={`Download version ${v.version}`}>
                  Download
                </a>
              )}
            </header>
            <p class="title">{v.title.en}</p>
            {groups.map(
              (g) =>
                v[g.key] &&
                (v[g.key] as Entry[]).length > 0 && (
                  <section class={`group ${g.key}`}>
                    <h3>{g.label}</h3>
                    <ul>
                      {(v[g.key] as Entry[]).map((e) => (
                        <li>{e.en}</li>
                      ))}
                    </ul>
                  </section>
                ),
            )}
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .upcoming {
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .layout {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(24px, 5vw, 64px);
    padding-bottom: clamp(64px, 9vw, 120px);
  }

  .layout > * {
    min-width: 0;
  }

  .index ul {
    position: sticky;
    top: 96px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 10px;
    color: var(--muted);
    font-weight: 650;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .index a:hover {
    color: var(--ink);
    background: rgba(243, 238, 250, 0.05);
  }

  .index .chip {
    font-size: 0.72rem;
    padding: 2px 8px;
  }

  .versions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .version {
    position: relative;
    padding: 0 0 48px 28px;
    border-left: 1px solid var(--line);
  }

  .version::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 10px;
    width: 11px;
    height: 11px;
    border-radius: 3px;
    background: var(--night);
    border: 2px solid var(--purple);
  }

  .version:first-child::before {
    background: var(--purple);
    box-shadow: 0 0 0 5px rgba(167, 85, 255, 0.18);
  }

  .version:last-child {
    padding-bottom: 0;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }

  h2 {
    font-size: var(--step-2);
    font-variant-numeric: tabular-nums;
  }

  time {
    color: var(--faint);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .dl {
    font-weight: 650;
    font-size: 0.95rem;
  }

  .title {
    margin-top: 8px;
    font-size: var(--step-1);
    color: #e9e1f5;
    max-width: 60ch;
  }

  .group {
    margin-top: 18px;
  }

  .group h3 {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 750;
    padding: 2px 10px;
    border-radius: var(--r-chip);
    margin-bottom: 8px;
  }

  .added h3 {
    background: rgba(167, 85, 255, 0.18);
    color: #e3ccff;
  }
  .changed h3 {
    background: rgba(120, 160, 255, 0.15);
    color: #cbd9ff;
  }
  .fixed h3 {
    background: rgba(110, 220, 160, 0.13);
    color: #bff0d3;
  }
  .removed h3 {
    background: rgba(255, 130, 130, 0.13);
    color: #ffd0d0;
  }

  .group ul {
    margin: 0;
    padding-left: 1.2em;
    max-width: var(--text);
    color: #d6cde3;
  }

  .group li + li {
    margin-top: 6px;
  }

  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .index ul {
      position: static;
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      max-height: none;
      gap: 6px;
      padding-bottom: 6px;
      -webkit-overflow-scrolling: touch;
    }
    .index a {
      border: 1px solid var(--line-soft);
      white-space: nowrap;
    }
    .version {
      padding-left: 20px;
    }
  }
</style>
