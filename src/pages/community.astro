---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Community" description="Join the Toad's Visuals Discord server, share your setups, report bugs and find the source code.">
  <section class="page-hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap">
      <h1>Community</h1>
      <p class="lead">Get help, share your setups and hear about updates first.</p>
    </div>
  </section>

  <div class="wrap content">
    <section class="discord glass" aria-labelledby="discord-title">
      <div class="discord-mark" aria-hidden="true">
        <Icon name="discord" size={40} />
      </div>
      <div class="discord-copy">
        <h2 id="discord-title">Join the Discord</h2>
        <p class="muted">
          The official server for Toad’s Visuals. Ask questions, post your crosshair and preset codes, report bugs and
          suggest features.
        </p>
      </div>
      <a class="btn btn-primary btn-lg" href={site.links.discord} target="_blank" rel="noopener">
        <Icon name="discord" size={22} />
        Join the server
      </a>
    </section>

    <div class="more">
      {
        site.links.github && (
          <section aria-labelledby="gh-title">
            <Icon name="github" size={26} />
            <h2 id="gh-title">Source code</h2>
            <p class="muted">The source code of the mod is on GitHub.</p>
            <a href={site.links.github} target="_blank" rel="noopener">
              View on GitHub <Icon name="external" size={15} />
            </a>
          </section>
        )
      }
      {
        site.links.modrinth && (
          <section aria-labelledby="mr-title">
            <Icon name="download" size={26} />
            <h2 id="mr-title">Modrinth</h2>
            <p class="muted">Follow the mod on Modrinth to get notified about updates.</p>
            <a href={site.links.modrinth} target="_blank" rel="noopener">
              Open on Modrinth <Icon name="external" size={15} />
            </a>
          </section>
        )
      }
      <section aria-labelledby="share-title">
        <Icon name="save" size={26} />
        <h2 id="share-title">Share your setup</h2>
        <p class="muted">
          Every preset can be exported as a share code. Post yours on Discord, others import it in the Presets page with one
          click.
        </p>
        <a href="/features/#presets">About presets</a>
      </section>
      <section aria-labelledby="bug-title">
        <Icon name="question" size={26} />
        <h2 id="bug-title">Report a bug</h2>
        <p class="muted">
          Tell us your Minecraft version, the mod version and what you did, and attach <code>logs/latest.log</code>. Check the
          FAQ first, many problems have a quick fix.
        </p>
        <a href="/faq/#problems">Common problems</a>
      </section>
      <section aria-labelledby="server-title">
        <Icon name="shield" size={26} />
        <h2 id="server-title">For server owners</h2>
        <p class="muted">Switch features off for players of the mod on your server, or pass player logos on.</p>
        <a href="/faq/#servers">Server options</a>
      </section>
    </div>
  </div>
</Base>

<style>
  .content {
    display: grid;
    gap: 28px;
    padding-bottom: clamp(64px, 9vw, 120px);
  }

  .discord {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    padding: clamp(24px, 4vw, 44px);
    background:
      radial-gradient(70% 140% at 0% 0%, rgba(88, 101, 242, 0.22), transparent 60%),
      var(--glass);
  }

  .discord-mark {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 22px;
    background: #5865f2;
    color: #fff;
    box-shadow: 0 16px 40px -14px rgba(88, 101, 242, 0.8);
  }

  .discord h2 {
    font-size: var(--step-3);
    margin-bottom: 8px;
  }

  .discord p {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    border-top: 1px solid var(--line-soft);
  }

  .more section {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 30px 28px 30px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .more section :global(svg:first-child) {
    color: var(--lilac);
  }

  .more h2 {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 750;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    min-height: 40px;
    width: fit-content;
  }

  @media (max-width: 860px) {
    .discord {
      grid-template-columns: auto 1fr;
    }
    .discord .btn {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .discord {
      grid-template-columns: 1fr;
    }
    .discord-mark {
      width: 64px;
      height: 64px;
      border-radius: 18px;
    }
    .more section {
      padding-right: 0;
    }
  }
</style>
