---
/**
 * "Try it": the Extras of the mod in a window that looks like the mod's own menu.
 * Browser previews – in game the mod uses Minecraft's rendering.
 */
import Icon from './Icon.astro';
import CrosshairPreview from './CrosshairPreview.astro';
import { killEffects } from '../data/features';

const modules = [
  { id: 'kill-effects', name: 'Kill effects', text: 'Effects when you kill someone', icon: 'spark' },
  { id: 'crosshair', name: 'Crosshair', text: 'Make your own crosshair', icon: 'target' },
  { id: 'glint', name: 'Glint styles', text: 'Enchantment glint in your colour', icon: 'palette' },
  { id: 'outline', name: 'Block outline', text: 'Your outline on the block you look at', icon: 'layers' },
  { id: 'hit-colour', name: 'Hit colour', text: 'Hurt flash in your colour, not red', icon: 'sun' },
  { id: 'hud', name: 'PvP HUD', text: 'Count totems, crystals and more', icon: 'hud' },
];
const effectIds: Record<string, string> = {
  Lightning: 'lightning', Gravestone: 'gravestone', Smoke: 'smoke', Firework: 'firework', Totem: 'totem', Souls: 'souls',
  'Red burst': 'red_burst', Hearts: 'hearts', Explosion: 'explosion', 'Flame spiral': 'flames', Ender: 'ender',
  Confetti: 'confetti', Shockwave: 'ring', 'Sonic boom': 'sonic', Helix: 'helix', 'Light pillar': 'pillar',
  'Crystal pop': 'crystal', 'Wind burst': 'wind',
};
const colours = ['#a755ff', '#c77dff', '#ff5555', '#55ff55', '#55ffff', '#ffff55', '#ffffff'];
---
<div class="pg" data-pg>
  <div class="window">
    <div class="titlebar">
      <span class="brand"><img src="/img/toad-128.png" width="22" height="22" alt="" />Toad's Visuals</span>
      <span class="tabs-fake" aria-hidden="true"><span>PVP</span><span class="on">EXTRAS</span></span>
      <span class="hint">Preview in your browser</span>
    </div>

    <div class="body">
      <div class="modules" role="tablist" aria-label="Extras" aria-orientation="vertical">
        {
          modules.map((m, i) => (
            <button type="button" role="tab" id={`tab-${m.id}`} data-tab={m.id} aria-controls={`panel-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="mi"><Icon name={m.icon} size={18} /></span>
              <span class="mt">
                <strong>{m.name}</strong>
                <small>{m.text}</small>
              </span>
            </button>
          ))
        }
      </div>

      <div class="panels">
        <section id="panel-kill-effects" role="tabpanel" aria-labelledby="tab-kill-effects" class="panel" data-ke>
          <div class="stage"><canvas data-ke-canvas role="img" aria-label="Kill effect preview"></canvas></div>
          <form class="controls" data-ke-form onsubmit="return false">
            <label class="field">
              <span>Effect</span>
              <select name="effect">
                {killEffects.map((k) => <option value={effectIds[k.name]}>{k.name}</option>)}
              </select>
            </label>
            <label class="field">
              <span>Size <output>100</output>%</span>
              <input type="range" name="size" min="50" max="200" value="100" oninput="this.previousElementSibling.querySelector('output').value=this.value" />
            </label>
            <fieldset class="field">
              <legend>Colour</legend>
              <div class="swatches">
                {colours.map((c, i) => (
                  <label class="sw" title={c}><input type="radio" name="colour" value={c} checked={i === 0} /><span style={`background:${c}`} /><span class="sr-only">{c}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="check"><input type="checkbox" name="rainbow" /> Rainbow</label>
            <button class="btn btn-primary btn-sm" type="button" data-ke-play><Icon name="spark" size={16} /> Play again</button>
          </form>
        </section>

        <section id="panel-crosshair" role="tabpanel" aria-labelledby="tab-crosshair" class="panel plain" hidden>
          <CrosshairPreview />
        </section>

        <section id="panel-glint" role="tabpanel" aria-labelledby="tab-glint" class="panel" data-gl hidden>
          <div class="stage"><canvas data-gl-canvas role="img" aria-label="Enchantment glint preview on a sword"></canvas></div>
          <form class="controls" data-gl-form onsubmit="return false">
            <fieldset class="field">
              <legend>Style</legend>
              <div class="pills">
                {[['tint', 'Coloured'], ['rainbow', 'Rainbow'], ['waves', 'Waves'], ['sparkle', 'Sparkle'], ['solid', 'Solid'], ['subtle', 'Subtle']].map(([v, n], i) => (
                  <label class="pill"><input type="radio" name="style" value={v} checked={i === 0} /><span>{n}</span></label>
                ))}
              </div>
            </fieldset>
            <fieldset class="field">
              <legend>Colour</legend>
              <div class="swatches">
                {colours.map((c, i) => (
                  <label class="sw" title={c}><input type="radio" name="colour" value={c} checked={i === 0} /><span style={`background:${c}`} /><span class="sr-only">{c}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="field">
              <span>Brightness <output>100</output>%</span>
              <input type="range" name="strength" min="20" max="150" value="100" oninput="this.previousElementSibling.querySelector('output').value=this.value" />
            </label>
          </form>
        </section>

        <section id="panel-outline" role="tabpanel" aria-labelledby="tab-outline" class="panel" data-ol hidden>
          <div class="stage"><canvas data-ol-canvas role="img" aria-label="Block outline preview"></canvas></div>
          <form class="controls" data-ol-form onsubmit="return false">
            <fieldset class="field">
              <legend>Colour</legend>
              <div class="swatches">
                {colours.map((c, i) => (
                  <label class="sw" title={c}><input type="radio" name="colour" value={c} checked={i === 0} /><span style={`background:${c}`} /><span class="sr-only">{c}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="check"><input type="checkbox" name="rainbow" /> Rainbow</label>
            <label class="field">
              <span>Thickness <output>200</output>%</span>
              <input type="range" name="width" min="100" max="500" value="200" oninput="this.previousElementSibling.querySelector('output').value=this.value" />
            </label>
            <label class="field">
              <span>Opacity <output>100</output>%</span>
              <input type="range" name="opacity" min="10" max="100" value="100" oninput="this.previousElementSibling.querySelector('output').value=this.value" />
            </label>
            <label class="check"><input type="checkbox" name="fill" checked /> See-through fill</label>
          </form>
        </section>

        <section id="panel-hit-colour" role="tabpanel" aria-labelledby="tab-hit-colour" class="panel" data-hc hidden>
          <div class="stage"><canvas data-hc-canvas role="img" aria-label="Hit colour preview"></canvas></div>
          <form class="controls" data-hc-form onsubmit="return false">
            <fieldset class="field">
              <legend>Flash colour</legend>
              <div class="swatches">
                {colours.map((c, i) => (
                  <label class="sw" title={c}><input type="radio" name="colour" value={c} checked={i === 0} /><span style={`background:${c}`} /><span class="sr-only">{c}</span></label>
                ))}
              </div>
            </fieldset>
            <label class="field">
              <span>Strength <output>35</output>%</span>
              <input type="range" name="strength" min="10" max="90" value="35" oninput="this.previousElementSibling.querySelector('output').value=this.value" />
            </label>
            <button class="btn btn-primary btn-sm" type="button" data-hc-hit><Icon name="target" size={16} /> Hit</button>
          </form>
        </section>

        <section id="panel-hud" role="tabpanel" aria-labelledby="tab-hud" class="panel" data-hud hidden>
          <div class="stage"><canvas data-hud-canvas role="img" aria-label="PvP HUD preview"></canvas></div>
          <form class="controls" data-hud-form onsubmit="return false">
            <fieldset class="field">
              <legend>Show</legend>
              <div class="pills">
                {[['totem', 'Totems'], ['crystal', 'Crystals'], ['gapple', 'Golden apples'], ['pearl', 'Pearls'], ['potion', 'Healing potions']].map(([v, n]) => (
                  <label class="pill"><input type="checkbox" name={v} checked /><span>{n}</span></label>
                ))}
              </div>
            </fieldset>
            <fieldset class="field">
              <legend>Layout</legend>
              <div class="pills">
                <label class="pill"><input type="radio" name="layout" value="column" checked /><span>Column</span></label>
                <label class="pill"><input type="radio" name="layout" value="row" /><span>Row</span></label>
              </div>
            </fieldset>
            <label class="field">
              <span>Size <output>100</output>%</span>
              <input type="range" name="scale" min="60" max="160" value="100" oninput="this.previousElementSibling.querySelector('output').value=this.value" />
            </label>
            <div class="two">
              <label class="field"><span>Text</span><input type="color" name="text" value="#ffffff" /></label>
              <label class="field"><span>Accent</span><input type="color" name="accent" value="#a755ff" /></label>
            </div>
            <label class="check"><input type="checkbox" name="bg" checked /> Background</label>
            <button class="btn btn-ghost btn-sm" type="button" data-hud-pop>Use a totem</button>
          </form>
        </section>
      </div>
    </div>
  </div>
  <p class="note muted">
    These are previews in your browser with the same options as the mod. In game, Toad's Visuals draws everything with
    Minecraft itself – with real particles, items and your textures.
  </p>
</div>

<script>
  import { killEffects, glint, outline, hitColour, hud, tabs } from '../scripts/playground';
  document.querySelectorAll<HTMLElement>('[data-pg]').forEach((root) => {
    tabs(root);
    root.querySelectorAll<HTMLElement>('[data-ke]').forEach(killEffects);
    root.querySelectorAll<HTMLElement>('[data-gl]').forEach(glint);
    root.querySelectorAll<HTMLElement>('[data-ol]').forEach(outline);
    root.querySelectorAll<HTMLElement>('[data-hc]').forEach(hitColour);
    root.querySelectorAll<HTMLElement>('[data-hud]').forEach(hud);
  });
</script>

<style>
  .window {
    border-radius: 20px;
    border: 1px solid var(--line);
    background: rgba(18, 12, 28, 0.88);
    box-shadow:
      0 40px 90px -40px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(167, 85, 255, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line-soft);
    background: linear-gradient(180deg, rgba(167, 85, 255, 0.12), transparent);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .tabs-fake {
    display: inline-flex;
    gap: 4px;
    margin: 0 auto;
    padding: 3px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .tabs-fake span {
    padding: 4px 14px;
    border-radius: 999px;
    color: var(--muted);
  }

  .tabs-fake .on {
    background: var(--purple);
    color: var(--on-purple);
  }

  .hint {
    color: var(--faint);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .body {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    min-height: 520px;
  }

  .modules {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 12px;
    border-right: 1px solid var(--line-soft);
    background: rgba(0, 0, 0, 0.18);
  }

  .modules button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }

  .modules button:hover {
    background: rgba(243, 238, 250, 0.05);
  }

  .modules button[aria-selected='true'] {
    background: rgba(167, 85, 255, 0.16);
    border-color: rgba(167, 85, 255, 0.35);
  }

  .mi {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(167, 85, 255, 0.14);
    color: var(--lilac);
  }

  .mt {
    display: grid;
    min-width: 0;
  }

  .mt strong {
    font-size: 0.95rem;
  }

  .mt small {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .panels {
    min-width: 0;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    height: 100%;
  }

  .panel[hidden] {
    display: none;
  }

  .panel.plain {
    display: block;
    padding: 16px;
  }

  .panel.plain[hidden] {
    display: none;
  }

  .panel.plain :global(.xh) {
    border-radius: 14px;
  }

  .stage {
    position: relative;
    min-height: 360px;
    border-right: 1px solid var(--line-soft);
  }

  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .controls {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: 22px;
  }

  .field {
    display: grid;
    gap: 8px;
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .field > span,
  .field legend {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0;
    margin-bottom: 8px;
  }

  .field > span {
    margin-bottom: 0;
  }

  .field output {
    color: var(--lilac);
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  select {
    min-height: 44px;
    padding: 0 12px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--night-3);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
  }

  input[type='range'] {
    width: 100%;
    accent-color: var(--purple);
    min-height: 32px;
  }

  input[type='color'] {
    width: 100%;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--night-3);
    padding: 3px;
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .sw {
    position: relative;
    width: 32px;
    height: 32px;
    cursor: pointer;
  }

  .sw input,
  .pill input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .sw span:first-of-type {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.35);
  }

  .sw:has(input:checked) span:first-of-type {
    box-shadow:
      0 0 0 2px var(--night),
      0 0 0 4px var(--lilac);
  }

  .sw:has(input:focus-visible),
  .pill:has(input:focus-visible) {
    outline: 2px solid var(--lilac);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pill {
    position: relative;
  }

  .pill span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 13px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(243, 238, 250, 0.03);
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--muted);
  }

  .pill:has(input:checked) span {
    background: rgba(167, 85, 255, 0.2);
    border-color: var(--purple);
    color: var(--ink);
  }

  .check {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    font-weight: 650;
    cursor: pointer;
  }

  .check input {
    width: 20px;
    height: 20px;
    accent-color: var(--purple);
  }

  .controls .btn {
    justify-self: start;
  }

  .note {
    margin-top: 14px;
    font-size: 0.92rem;
    max-width: 70ch;
  }

  @media (max-width: 980px) {
    .body {
      grid-template-columns: 1fr;
    }
    .modules {
      display: flex;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
      gap: 6px;
      padding: 10px;
      scrollbar-width: thin;
    }
    .modules button {
      width: auto;
      flex: none;
      padding: 8px 12px;
    }
    .mt small {
      display: none;
    }
    .panel {
      grid-template-columns: 1fr;
    }
    .stage {
      min-height: 300px;
      border-right: 0;
      border-bottom: 1px solid var(--line-soft);
    }
    .hint {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .tabs-fake {
      display: none;
    }
    .titlebar {
      justify-content: space-between;
    }
    .stage {
      min-height: 250px;
    }
    .panel.plain {
      padding: 0;
    }
    .panel.plain :global(.xh) {
      border: 0;
      border-radius: 0;
    }
  }
</style>
