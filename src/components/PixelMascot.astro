---
/**
 * The mascot as it appears in game: the mod's real 32×32 logo glyph.
 * On page load its pixels fly into place once (skipped with reduced motion).
 */
interface Props { size?: number; animate?: boolean; class?: string }
const { size = 320, animate = true, class: cls = '' } = Astro.props;
---
<div class:list={['mascot', cls]} style={`--size:${size}px`} data-mascot={animate ? 'animate' : 'static'}>
  <div class="halo" aria-hidden="true"></div>
  <img class="px" src="/img/toad-pixel-32.png" width="32" height="32" alt="" aria-hidden="true" />
  <canvas width="32" height="32" aria-hidden="true"></canvas>
  <img class="hd" src="/img/toad-512.png" width="512" height="512" alt="The Toad's Visuals mascot: a purple mushroom" fetchpriority="high" />
</div>

<script>
  type Px = { x: number; y: number; c: string; sx: number; sy: number; d: number };

  function run(root: HTMLElement) {
    const img = root.querySelector<HTMLImageElement>('img.px')!;
    const canvas = root.querySelector('canvas')!;
    if (root.dataset.mascot !== 'animate' || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const start = () => {
      const src = document.createElement('canvas');
      src.width = src.height = 32;
      const sctx = src.getContext('2d')!;
      sctx.drawImage(img, 0, 0);
      let data: Uint8ClampedArray;
      try {
        data = sctx.getImageData(0, 0, 32, 32).data;
      } catch {
        return;
      }
      const px: Px[] = [];
      for (let y = 0; y < 32; y++) {
        for (let x = 0; x < 32; x++) {
          const i = (y * 32 + x) * 4;
          if (data[i + 3] < 20) continue;
          const angle = Math.random() * Math.PI * 2;
          const dist = 10 + Math.random() * 18;
          px.push({
            x,
            y,
            c: `rgba(${data[i]},${data[i + 1]},${data[i + 2]},${data[i + 3] / 255})`,
            sx: x + Math.cos(angle) * dist,
            sy: y + Math.sin(angle) * dist + 8,
            d: (x + (31 - y)) * 9 + Math.random() * 160,
          });
        }
      }

      const rect = root.getBoundingClientRect();
      const cell = Math.max(2, Math.round((rect.width * (window.devicePixelRatio || 1)) / 32));
      canvas.width = canvas.height = 32 * cell;
      const ctx = canvas.getContext('2d')!;
      ctx.imageSmoothingEnabled = false;
      root.classList.add('running');

      const DURATION = 720;
      const t0 = performance.now();
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const frame = (now: number) => {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let done = true;
        for (const p of px) {
          const t = Math.min(1, Math.max(0, (now - t0 - p.d) / DURATION));
          if (t < 1) done = false;
          if (t <= 0) continue;
          const e = ease(t);
          const x = p.sx + (p.x - p.sx) * e;
          const y = p.sy + (p.y - p.sy) * e;
          ctx.globalAlpha = Math.min(1, t * 1.6);
          ctx.fillStyle = p.c;
          ctx.fillRect(Math.round(x * cell), Math.round(y * cell), cell, cell);
        }
        if (!done) requestAnimationFrame(frame);
        else root.classList.add('done');
      };
      requestAnimationFrame(frame);
    };

    if (img.complete && img.naturalWidth) start();
    else img.addEventListener('load', start, { once: true });
  }

  document.querySelectorAll<HTMLElement>('[data-mascot]').forEach(run);
</script>

<style>
  .mascot {
    position: relative;
    width: min(var(--size), 78vw);
    aspect-ratio: 1;
  }

  .mascot img,
  .mascot canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .mascot .px,
  .mascot canvas {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* without script or with reduced motion: only the sharp mascot */
  .mascot .px,
  .mascot canvas {
    opacity: 0;
  }

  /* the pixels fly in, then the sharp mascot takes over */
  .mascot.running .hd {
    opacity: 0;
  }

  .mascot.running canvas {
    opacity: 1;
  }

  .mascot .hd {
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }

  .mascot.done .hd {
    opacity: 1;
    transform: scale(1);
  }

  .mascot.done canvas {
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .halo {
    position: absolute;
    inset: -18%;
    background: radial-gradient(closest-side, rgba(167, 85, 255, 0.45), rgba(167, 85, 255, 0.12) 55%, transparent 75%);
    filter: blur(8px);
  }
</style>
